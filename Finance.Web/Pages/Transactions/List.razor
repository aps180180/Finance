@page "/lancamentos/historico"

@inherits ListTransactionsPage

<MudText Typo="Typo.h3">Lançamentos</MudText>
<div class="d-flex justify-end mt-4 mb-4">
    <MudSelect T="int"
               Label="Mês"
               @bind-Value="@CurrentMonth"
               AnchorOrigin="Origin.BottomCenter"
               Class="mr-4">
        @for (var month = 1; month <= 12; month++)
        {
            var date = new DateTime(DateTime.Now.Year, month, 1);
            <MudSelectItem T="int" Value="@month">
                @date.ToString("MMMM")
            </MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="int"
               Label="Ano"
               @bind-Value="@CurrentYear"
               AnchorOrigin="Origin.BottomCenter">
        @foreach (var year in Years)
        {
            <MudSelectItem T="int" Value="@year">
                @year
            </MudSelectItem>
        }
    </MudSelect>
    <MudSpacer />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Small"
               StartIcon="@Icons.TwoTone.Search" OnClick="OnSearchAsync">
        Pesquisar
    </MudButton>
</div>
<MudDataGrid Items="@Transactions"
             Filterable="true"
             QuickFilter="Filter"
             Hideable="false"
             ColumnResizeMode="ResizeMode.Column">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Lançamentos</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="SearchTerm"
                      Placeholder="Filtrar..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="false"
                      IconSize="Size.Medium"
                      Class="mt-0" />
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x=> x.Id" Title="Nº Lancto" />

        <PropertyColumn Property="x=> x.PaidOrReceivedAt" Title="Dt. Pagto/Receb." Format="dd/MM/yyyy" Filterable="false" />
        <PropertyColumn Property="x=> x.Title" Title="Lançamento" Filterable="false" />
        <TemplateColumn Title="Tipo" Filterable="true">
            <CellTemplate>
                @if (context.Item.Type == ETransactionType.Entrada)
                {
                    <MudChip Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                        Entrada
                    </MudChip>
                }
                else
                {
                    <MudChip Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">
                        Saída
                    </MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x=> x.Amount"
                        Format="C"
                        Title="Valor"
                        Sortable="true"
                        Filterable="false">
            <FooterTemplate>
                @context.Items.Sum(x => x.Amount).ToString("C")
            </FooterTemplate>
        </PropertyColumn>
        <TemplateColumn Class="d-flex justfy-end" Filterable="false">
            <CellTemplate>
                <MudStack Row>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary" Href="@($"/lancamentos/editar/{context.Item.Id}")">
                    </MudIconButton>
                    <MudIconButton Color="Color.Error"
                                   aria-label="Excluir"
                                   OnClick="()=>OnDeleteButtonClickAsync(context.Item.Id,context.Item.Title)"
                                   Icon="@Icons.Material.Filled.Delete"></MudIconButton>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</MudDataGrid>
